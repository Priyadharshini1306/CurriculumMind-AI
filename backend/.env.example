# Copy to backend/.env and fill in. Never commit the real .env.

# MongoDB Atlas (users, sessions, uploads, review drafts/feedback, quiz history)
MONGODB_URI=
MONGODB_DB=curriculummind

# Neo4j AuraDB (knowledge graph, vector search, mastery)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# DEV ONLY. Set to true if a firewall/antivirus intercepts TLS and Neo4j fails with
# "self-signed certificate in certificate chain". Leave false everywhere else.
NEO4J_TRUST_SELF_SIGNED=false

# Groq (cloud LLM, OpenAI-compatible API) -- get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# YouTube Data API v3 key (resource discovery). DuckDuckGo needs no key.
YOUTUBE_API_KEY=

# Signing key for login tokens: at least 32 random characters, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=20
